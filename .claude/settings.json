{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npm run preview*)",
      "Bash(npm run ocean*)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npx tsc*)",
      "Bash(npx vite*)",
      "Bash(node --test*)",
      "Bash(node dev/*)",
      "Bash(node .claude/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git merge-base*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git worktree add*)",
      "Bash(git worktree list*)",
      "Bash(git worktree prune*)",
      "Bash(git push -u origin ocean/*)",
      "Bash(git push origin ocean/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin feature/*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "PowerShell(npm run dev*)",
      "PowerShell(npm run build*)",
      "PowerShell(npm run preview*)",
      "PowerShell(npm run ocean*)",
      "PowerShell(npm test*)",
      "PowerShell(npm ls*)",
      "PowerShell(npx tsc*)",
      "PowerShell(npx vite*)",
      "PowerShell(node --test*)",
      "PowerShell(node dev/*)",
      "PowerShell(node .claude/*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git blame*)",
      "PowerShell(git grep*)",
      "PowerShell(git branch*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git ls-files*)",
      "PowerShell(git merge-base*)",
      "PowerShell(git fetch*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git stash*)",
      "PowerShell(git switch*)",
      "PowerShell(git checkout*)",
      "PowerShell(git worktree add*)",
      "PowerShell(git worktree list*)",
      "PowerShell(git worktree prune*)",
      "PowerShell(git push -u origin ocean/*)",
      "PowerShell(git push origin ocean/*)",
      "PowerShell(git push -u origin feature/*)",
      "PowerShell(git push origin feature/*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr diff*)",
      "PowerShell(gh pr checks*)"
    ],
    "ask": [
      "Bash(rm -rf*)",
      "Bash(rm -r *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git worktree remove --force*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "PowerShell(Remove-Item*-Recurse*)",
      "PowerShell(rm -r*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git worktree remove --force*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * master*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler publish*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler publish*)",
      "Bash(npm publish*)",
      "Bash(git filter-branch*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f*)",
      "PowerShell(git push* main*)",
      "PowerShell(git push*:main*)",
      "PowerShell(git push* master*)",
      "PowerShell(git push*--mirror*)",
      "PowerShell(*wrangler deploy*)",
      "PowerShell(*wrangler publish*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(npm publish*)",
      "PowerShell(git filter-branch*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.mjs\"" }
        ]
      }
    ]
  }
}
